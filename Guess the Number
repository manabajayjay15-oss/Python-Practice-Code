import random
 
MAX_ATTEMPTS = 7
 
 
def get_guess():
    """Keep asking until the player types a whole number from 1 to 100."""
    while True:
        text = input("Your guess (1-100): ")
        if text.isdigit() and 1 <= int(text) <= 100:
            return int(text)
        print("Please enter a whole number from 1 to 100.")
 
 
def play_round():
    """Play one game. Return the attempt number if won, or None if lost."""
    secret = random.randint(1, 100)
    print(f"\nI'm thinking of a number from 1 to 100. You have {MAX_ATTEMPTS} tries.")
 
    for attempt in range(1, MAX_ATTEMPTS + 1):
        guess = get_guess()
 
        if guess == secret:
            print(f"Correct! You got it in {attempt} tries.")
            return attempt
        elif guess < secret:
            print("Too low.")
        else:
            print("Too high.")
 
        print(f"Attempts left: {MAX_ATTEMPTS - attempt}")
 
    print(f"Out of attempts! The number was {secret}.")
    return None
 
 
def main():
    print("=== Number Guessing Game ===")
    games = 0
    wins = 0
 
    while True:
        games += 1
        result = play_round()
        if result is not None:
            wins += 1
 
        again = input("\nPlay again? (yes/no): ").lower()
        if again != "yes":
            break
 
    print(f"\nYou won {wins} of {games} games. Thanks for playing!")
 
 
main()
 
